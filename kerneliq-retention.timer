# KernelIQ user systemd timer — install to ~/.config/systemd/user/, then:
#   systemctl --user daemon-reload
#   systemctl --user enable --now kerneliq-retention.timer
# Triggers kerneliq-retention.service on the calendar below.

[Unit]
# Describes the schedule in systemctl list-timers.
Description=Run KernelIQ retention cleanup daily

[Timer]
# Once per day at 00:00:00 in the local timezone (systemd calendar semantics).
OnCalendar=daily
# If the machine was off at the scheduled time, run once after boot catches up.
Persistent=true

[Install]
# Hook into the user session timer target so enable/start work as expected.
WantedBy=timers.target
